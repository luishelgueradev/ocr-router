# === REQUIRED ===

# Bearer token for the /v1/* HTTP API (consumed by n8n and any other client).
# Generate with: openssl rand -hex 32
# The server REFUSES to start if this is empty or equals this placeholder string
# (server.js rejects this literal value — Pitfall 5).
API_TOKEN=generate-with-openssl-rand-hex-32

# Ollama Cloud API key. Required to run the vision models.
# Get from https://ollama.com/settings/keys
# Placeholder uses angle brackets so no secret scanner mistakes it for a real key (Pitfall 5).
OLLAMA_API_KEY=<paste-key-from-ollama.com/settings/keys>

# Public domain pointed at this VPS (A record). Caddy uses this for automatic HTTPS
# via Let's Encrypt; DNS must already resolve before the first `docker compose up -d`.
DOMAIN=your-vps-domain.example.com

# Tailscale IP of this VPS — used to bind the admin panel port (8780) to the tailnet only.
# Obtain with: tailscale ip -4
# If empty OR left as this placeholder, the admin panel would bind on 0.0.0.0 (PUBLIC INTERNET).
# server.js REFUSES to start in production when this is empty or equals the literal
# string `100.x.x.x` (Pitfall 5; mitigates T-01-06 admin exposure).
TAILSCALE_IP=100.x.x.x

# === OPTIONAL (have safe defaults) ===

# Express port inside the container. Default 3000.
PORT=3000

# OCR.space API key. Leave empty to disable the OCR.space provider; LLM models still work.
OCR_SPACE_API_KEY=

# Max image upload size in bytes. Default 10485760 (10 MB).
MAX_UPLOAD_BYTES=10485760

# Pino log level: trace | debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info

# Max queued jobs before the API returns 503 server_busy. Default 10.
MAX_QUEUE_DEPTH=10

# Max job records held in memory (LRU). Default 500.
JOB_STORE_MAX=500
